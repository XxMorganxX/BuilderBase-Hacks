{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "session-oracle-hook summary",
  "type": "object",
  "required": ["schema_version", "source_agent", "session_id", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "source_agent": {
      "type": "string",
      "description": "Which coding-agent tool produced the session: claude-code | codex | openclaw | ..."
    },
    "session_id": { "type": "string" },
    "cwd": { "type": "string" },
    "generated_at": { "type": "string", "description": "UTC timestamp, YYYYMMDDTHHMMSSZ" },
    "parse_error": {
      "type": "boolean",
      "description": "True if the summarizer model did not return valid JSON. When true, only `raw` is populated."
    },
    "raw": { "type": "string" },
    "high_level": {
      "type": "object",
      "properties": {
        "task": { "type": "string" },
        "outcome": { "type": "string", "enum": ["done", "partial", "blocked", "failed"] },
        "summary": { "type": "string" },
        "key_decisions": { "type": "array", "items": { "type": "string" } },
        "next_steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "low_level": {
      "type": "object",
      "properties": {
        "files_changed": { "type": "array", "items": { "type": "string" } },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "tool_call_count": { "type": "integer" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
