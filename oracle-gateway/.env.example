# Oracle configuration. Copy to db/.env on the server, or export before running
# the gateway locally. Single source of truth for configuration (PRINCIPLES P8).

# --- server: database + gateway ------------------------------------------
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oracle:change-me-before-deploying@localhost:5432/oracle
ORACLE_GATEWAY_PORT=8080
ORACLE_LOG_LEVEL=info

# Users to create on first deploy: email:Name, comma separated.
SEED_USERS=alice@example.com:Alice,bob@example.com:Bob

# --- laptop: shipper ------------------------------------------------------
ORACLE_GATEWAY_URL=http://SERVER-HOST:8080
ORACLE_TOKEN=ork_paste-the-token-the-seed-script-printed

# --- optional gateway tuning (defaults shown) -----------------------------
# ORACLE_MAX_EVENTS_PER_BATCH=1000
# ORACLE_MAX_BODY_BYTES=10485760
# ORACLE_CONTENT_TEXT_MAX=8192
# ORACLE_DEFAULT_PAGE_LIMIT=500
